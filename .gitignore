## .NET / Visual Studio .gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache/options directory
.vs/

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# MSBuild Binary and Structured Log
*.binlog

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Rider
.idea/

# VS Code
.vscode/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Windows shortcuts
*.lnk

# Publish/deploy
[Pp]ublish/
*.pubxml
*.publishproj
PublishScripts/

# ClickOnce
*.publish.xml

# Others
*.tmp
*.bak
*.swp
*~
