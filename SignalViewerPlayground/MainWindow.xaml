<pages:BaseWindow
    x:Class="SignalViewerPlayground.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SignalViewerPlayground.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SignalViewerPlayground"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:SignalViewerPlayground.Pages"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock FontSize="32" Text="{Binding Status}" />

            <controls:LoadingSpinner
                FontSize="32"
                IsActive="{Binding IsBusy}"
                Color="DimGray" />
        </StackPanel>


    </Grid>
</pages:BaseWindow>
